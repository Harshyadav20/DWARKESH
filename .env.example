# ---------------------------------------------------------------------------
# Dwarkesh Medical Centre LLP — environment variables
# Copy this file to `.env.local` and fill in only what you need.
# Every variable is OPTIONAL: the site works with sensible defaults and
# gracefully disables the features that need a key.
# ---------------------------------------------------------------------------

# Public site URL (used for canonical URLs, sitemap.xml, robots.txt, schema.org
# and Open Graph metadata). Must have no trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Admin panel (/admin)
# ---------------------------------------------------------------------------
# Password used to sign in to the admin dashboard. REQUIRED to use /admin.
ADMIN_PASSWORD=
# Secret used to sign the admin session cookie. Use a long random string
# (e.g. `openssl rand -hex 32`). Defaults to ADMIN_PASSWORD if not set.
AUTH_SECRET=
# Session lifetime in hours (default: 8)
ADMIN_SESSION_HOURS=8

# ---------------------------------------------------------------------------
# Database — Supabase / PostgreSQL (optional)
# Without these the site uses the bundled JSON content store, which is
# fine for local development but read-only on serverless hosts.
# See supabase/schema.sql for the table definitions.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Appointment e-mail notifications (optional — Resend)
# Server-side only. Never expose this in NEXT_PUBLIC_*.
# ---------------------------------------------------------------------------
RESEND_API_KEY=
APPOINTMENT_NOTIFY_EMAIL=dwarkeshmedicalcentre06@gmail.com
EMAIL_FROM="Dwarkesh Medical Centre <onboarding@resend.dev>"

# ---------------------------------------------------------------------------
# Google Maps (optional)
# The site falls back to a key-less map + "Get Directions" link.
# Provide either an official Embed API URL or an API key to upgrade.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_MAPS_EMBED_URL=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Only set these if the clinic supplies exact coordinates. Do not guess.
NEXT_PUBLIC_CLINIC_LAT=
NEXT_PUBLIC_CLINIC_LNG=

# ---------------------------------------------------------------------------
# Analytics (optional) — e.g. Vercel Analytics / GA4 measurement id
# ---------------------------------------------------------------------------
NEXT_PUBLIC_GA_MEASUREMENT_ID=
